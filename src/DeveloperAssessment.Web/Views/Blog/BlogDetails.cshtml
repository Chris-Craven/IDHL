<div class="container">
    <div class="row">

        <!-- Blog post content -->
        <div class="col-lg-12">
            <!-- Title -->
            <h1 class="mt-4">@Model.Title</h1>
            <hr>
            <!-- Date/Time -->
            <p>@Model.Date</p>
            <hr>
            <!-- Preview Image -->
            <img class="img-fluid rounded" src=@Model.Image alt="Blog Image">
            <hr>
            <!-- Post Content -->
            @Html.Raw(@Model.HtmlContent)
            <hr>
            <!-- Blog post comment form -->
            @using (Html.BeginForm("AddComment", "Blog", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <input type="hidden" name="BlogId" value="@Model.Id"/>
                <div class="card my-4">
                    <h5 class="card-header">Leave a Comment:</h5>
                    <div class="card-body">
                        <form>
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label for="Name">Name</label>
                                    <input type="text" name="Name" class="form-control" id="Name" placeholder="Name">
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="EmailAddress">Email Address</label>
                                    <input type="email" name="EmailAddress" class="form-control" id="EmailAddress"
                                           placeholder="Email Address">
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="Message">Message</label>
                                <textarea id="Message" name="Message" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="form-group">
                                <label for="file">Image</label>
                                <input type="file" name="file" id="file" class="form-control"/>
                            </div>
                            <button type="submit" class="btn btn-primary mt-1">Submit</button>
                        </form>
                    </div>
                </div>
            }

            <!-- Blog post comments -->
            @if (Model.Comments != null)
            {
                @foreach (var comment in Model.Comments)
                {
                    <div class="media mb-4">
                        <img class="d-flex mr-3 rounded-circle user-avatar"
                             src="https://eu.ui-avatars.com/api/?name=@comment.Name" alt="Guest">
                        <div class="media-body">
                            <h5 class="mt-0">@comment.Name<small><em>(@comment.Date)</em></small></h5>
                            @comment.Message
                        </div>
                        @if (comment.ImageUrl != null)
                        {
                            <img src="~/UploadedFiles/@comment.ImageUrl" class="cardimg"/>
                        }
                    </div>

                    if (comment.BlogPostReplies != null)
                    {
                        @foreach (var reply in comment.BlogPostReplies)
                        {
                            <div class="media offset-1">
                                <img class="d-flex mr-3 rounded-circle user-avatar"
                                     src="https://eu.ui-avatars.com/api/?name=@reply.Name" alt="Guest">
                                <div class="media-body">
                                    <h5 class="mt-0">@reply.Name<small><em>(@reply.Date)</em></small></h5>
                                    @reply.Message
                                </div>
                            </div>
                        }
                    }

                    <div class="btn btn-primary mt-3 offset-1" href="@("#reply" + @comment.Id)"
                         data-bs-toggle="collapse">Leave Reply
                    </div>
                    @using (Html.BeginForm("AddReply", "Blog", FormMethod.Post))
                    {
                        <input type="hidden" name="BlogId" value="@Model.Id"/>
                        <input type="hidden" name="CommentId" value="@comment.Id"/>
                        <div class="card mt-4 collapse offset-1" id="@("reply" + comment.Id)">
                            <h5 class="card-header">Leave a Reply:</h5>
                            <div class="card-body">
                                <form>
                                    <div class="form-row">
                                        <div class="form-group col-md-6">
                                            <label for="Name">Name</label>
                                            <input type="text" name="Name" class="form-control" id="Name"
                                                   placeholder="Name">
                                        </div>
                                        <div class="form-group col-md-6">
                                            <label for="EmailAddress">Email Address</label>
                                            <input type="email" name="EmailAddress" class="form-control"
                                                   id="EmailAddress" placeholder="Email Address">
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="Message">Message</label>
                                        <textarea id="Message" name="Message" class="form-control" rows="3"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary mt-1">Submit</button>
                                </form>
                            </div>
                        </div>
                    }

                    <hr/>
                }
            }
        </div>
    </div>
</div>